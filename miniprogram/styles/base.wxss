/* 设计 token：两枚球队蓝 + 中性色。改主题只改这一段。 */
page {
  --brand-900: #0B0A3D;
  --brand-800: #141371;
  --brand-700: #073A8B;
  --brand-600: #0F52B5;
  --brand-100: #E7EDF9;
  --brand-50: #F2F5FC;
  --ink: #0B0A3D;
  --ink2: #1D2F4A;
  --muted: #7B8AA3;
  --faint: #A9B6C9;
  --bg: #F4F7FC;
  --line: #E4EAF3;
  --white: #FFFFFF;
  --green: #0FA968;
  --amber: #F5A524;
  --red: #E5484D;
  --shadow: 0 8rpx 24rpx rgba(10, 27, 51, 0.10);
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

view, text, scroll-view { box-sizing: border-box; }

.wrap { padding: 0 28rpx; }
.pad { padding: 28rpx; }
.pad-b { padding-bottom: 60rpx; }

.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.wrap-t { flex-wrap: wrap; }
.g6 > view + view, .g6 > view + text { margin-left: 12rpx; }
.g8 > view + view { margin-left: 16rpx; }
.g12 > view + view { margin-left: 24rpx; }
.mt8 { margin-top: 16rpx; }
.mt12 { margin-top: 24rpx; }
.mt16 { margin-top: 32rpx; }
.mt20 { margin-top: 40rpx; }
.mt24 { margin-top: 48rpx; }

.t24 { font-size: 48rpx; font-weight: 700; line-height: 1.25; letter-spacing: -0.5rpx; }
.t20 { font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.t17 { font-size: 34rpx; font-weight: 700; }
.t15 { font-size: 30rpx; font-weight: 600; }
.t14 { font-size: 28rpx; }
.t13 { font-size: 26rpx; }
.t12 { font-size: 24rpx; }
.t11 { font-size: 22rpx; }
.muted { color: var(--muted); }
.faint { color: var(--faint); }
.bold { font-weight: 700; }
.mono-num { font-variant-numeric: tabular-nums; letter-spacing: -0.5rpx; }
.ink2 { color: var(--ink2); }
.brand { color: var(--brand-700); }

.card {
  background: var(--white);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
  padding: 32rpx;
}
.card.flat { box-shadow: none; border: 2rpx solid var(--line); }
.card.dark {
  background: linear-gradient(155deg, var(--brand-800) 0%, #0D2B67 58%, var(--brand-700) 100%);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(11, 10, 61, 0.28);
}
.card.dark .muted { color: rgba(255, 255, 255, 0.62); }

.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 0 20rpx;
}
.sec .h { font-size: 34rpx; font-weight: 700; }
.sec .more { font-size: 24rpx; color: var(--muted); }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--brand-100);
  color: var(--brand-700);
}
.tag.green { background: rgba(15, 169, 104, 0.12); color: var(--green); }
.tag.amber { background: rgba(245, 165, 36, 0.14); color: #B87800; }
.tag.red { background: rgba(229, 72, 77, 0.12); color: var(--red); }
.tag.gray { background: #EEF1F6; color: var(--muted); }
.tag.dark { background: rgba(20, 19, 113, 0.9); color: #fff; }

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--white);
  color: var(--brand-700);
  border: 2rpx solid var(--line);
}
.btn.primary { background: var(--brand-700); color: #fff; border-color: var(--brand-700); }
.btn.dark { background: var(--brand-900); color: #fff; border-color: var(--brand-900); }
.btn.ghost { background: transparent; border-color: rgba(7, 58, 139, 0.28); }
.btn.sm { height: 68rpx; padding: 0 28rpx; font-size: 26rpx; border-radius: 18rpx; }
.btn.block { width: 100%; }
.btn:active { opacity: 0.86; }

.chip {
  flex: none;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 16rpx;
  background: var(--white);
  border: 2rpx solid var(--line);
  color: var(--ink2);
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
}
.chip.on { background: var(--brand-900); border-color: var(--brand-900); color: #fff; font-weight: 600; }

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, var(--brand-700), var(--brand-600));
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar.sm { width: 44rpx; height: 44rpx; font-size: 20rpx; }
.avatar.lg { width: 108rpx; height: 108rpx; font-size: 40rpx; }

.hr { height: 2rpx; background: var(--line); }

.list { background: var(--white); border-radius: 28rpx; overflow: hidden; }
.li {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
  background: var(--white);
}
.li:last-child { border-bottom: 0; }
.li:active { background: #FAFBFE; }
.li .go { color: var(--faint); font-size: 28rpx; margin-left: 12rpx; }

.empty { padding: 80rpx 0; text-align: center; color: var(--muted); font-size: 26rpx; }
.foot { text-align: center; color: var(--faint); font-size: 22rpx; padding: 56rpx 40rpx 40rpx; line-height: 1.7; }

/* —— 补齐通用件（首页/名册/我的/照片页共用） —— */
.mt6 { margin-top: 12rpx; }
.ml12 { margin-left: 24rpx; }
.ml16 { margin-left: 32rpx; }
.white { color: #fff; }

.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.g3i { min-width: 0; }

.li-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--brand-50);
  color: var(--brand-700);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex: none;
}
.li-arw { color: var(--faint); font-size: 32rpx; margin-left: 12rpx; }

/* 数字条：首页与「我的」共用，页面只需覆盖 margin */
.stats { display: flex; padding: 30rpx 10rpx; }
.sb { flex: 1; text-align: center; position: relative; }
.sb + .sb::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: var(--line);
}
.sb-v { font-size: 46rpx; font-weight: 700; line-height: 1.1; }
.sb-u { font-size: 22rpx; font-weight: 600; color: var(--brand-700); margin-left: 2rpx; }
.sb-l { font-size: 21rpx; color: var(--muted); margin-top: 10rpx; }
