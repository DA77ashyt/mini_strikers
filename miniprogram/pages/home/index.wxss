.hero {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: linear-gradient(165deg, var(--brand-900) 0%, var(--brand-800) 46%, var(--brand-700) 100%);
}
.hero-art {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background:
    repeating-linear-gradient(180deg, rgba(163, 196, 240, 0.09) 0, rgba(163, 196, 240, 0.09) 3rpx, rgba(0, 0, 0, 0) 3rpx, rgba(0, 0, 0, 0) 90rpx),
    linear-gradient(180deg, rgba(7, 58, 139, 0) 0%, rgba(7, 58, 139, 0.35) 40%, rgba(4, 8, 24, 0.75) 100%);
}
.hero-in {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 96rpx;
  color: #fff;
}
.crest {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 34rpx;
}
.kick { font-size: 30rpx; letter-spacing: 12rpx; font-weight: 700; }
.kick-sub { font-size: 22rpx; letter-spacing: 3rpx; color: rgba(198, 216, 252, 0.9); margin-top: 10rpx; }
.yrs { font-size: 76rpx; font-weight: 700; letter-spacing: -1rpx; margin-top: 18rpx; line-height: 1.1; }
.motto { font-size: 26rpx; color: rgba(255, 255, 255, 0.82); margin-top: 16rpx; }
.hero-btn {
  display: inline-flex;
  margin-top: 34rpx;
  height: 76rpx;
  border-color: rgba(255, 255, 255, 0.42);
  color: #fff;
  font-size: 26rpx;
  padding: 0 32rpx;
}

.stats {
  position: relative;
  margin: -56rpx 28rpx 0;
}

.quote {
  margin-top: 36rpx;
  padding: 32rpx 32rpx 30rpx;
  background: var(--brand-50);
  border-left: 6rpx solid var(--brand-700);
  border-radius: 8rpx 24rpx 24rpx 8rpx;
}
.qmark { font-size: 44rpx; color: var(--brand-600); line-height: 0.6; }
.q-text { font-size: 30rpx; line-height: 1.7; margin-top: 10rpx; color: var(--ink2); }
.q-by { font-size: 26rpx; font-weight: 700; margin-top: 22rpx; }
.q-role { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }

.evcard {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  margin-bottom: 28rpx;
}
.ev-body { padding: 24rpx 28rpx 28rpx; }
.ev-sum {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hscroll { display: flex; white-space: nowrap; }
.hcard {
  flex: none;
  width: 268rpx;
  margin-right: 20rpx;
}
.hcard:last-child { margin-right: 0; }

.gradwall {
  background: linear-gradient(155deg, var(--brand-800) 0%, #0D2B67 60%, var(--brand-700) 100%);
  color: #fff;
}
.gw-t { font-size: 32rpx; font-weight: 700; }
.gw-s { color: rgba(255, 255, 255, 0.66); margin-top: 8rpx; }
.gw-go { font-size: 40rpx; color: rgba(255, 255, 255, 0.8); }

.rec { padding: 6rpx 28rpx; }
.rec-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.rec-row:last-child { border-bottom: 0; }
.rec-v { font-size: 40rpx; font-weight: 700; color: var(--brand-700); }
